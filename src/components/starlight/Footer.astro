---
// Starlight's footer, plus the site-wide pal on every docs page (the docs use their own product).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="pal-note">
  The pal in the corner is pagepal itself.
  <button type="button" data-pal-restore hidden>Bring it back</button>
</p>

<script>
  import { mountDisplayPals } from '../../scripts/display-pal';
  import { startSitePal } from '../../scripts/site-pal';
  startSitePal({ size: 64 });
  mountDisplayPals();
</script>

<style>
  .pal-note {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  button {
    font: inherit;
    color: var(--sl-color-accent-high);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
</style>
